<!ELEMENT senderCity (#PCDATA)>
<!ELEMENT recipientCity (#PCDATA)>
<!ELEMENT weightKg (#PCDATA)>
<!ELEMENT deliveryCost (#PCDATA)>
<!ELEMENT sentDate (#PCDATA)>
<!ELEMENT note (#PCDATA)>
